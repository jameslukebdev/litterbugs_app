{
  "name": "litterbugs-partner",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "node scripts/apply-mobile-patches.mjs",
    "mobile:start": "npm run start --workspace @litterbugs/mobile",
    "mobile:ios": "npm run ios --workspace @litterbugs/mobile",
    "mobile:android": "npm run android --workspace @litterbugs/mobile",
    "mobile:doctor": "cd apps/mobile && npx expo-doctor",
    "mobile:config": "cd apps/mobile && npx expo config --json",
    "mobile:build:android:qa": "cd apps/mobile && npx eas-cli build --platform android --profile preview",
    "mobile:build:ios:qa": "cd apps/mobile && npx eas-cli build --platform ios --profile preview",
    "mobile:build:ios:simulator": "cd apps/mobile && npx eas-cli build --platform ios --profile development-simulator",
    "mobile:build:ios:primary": "cd apps/mobile && npx eas-cli build --platform ios --profile development-primary",
    "mobile:build:android:production": "cd apps/mobile && npx eas-cli build --platform android --profile production",
    "mobile:build:ios:production": "cd apps/mobile && npx eas-cli build --platform ios --profile production",
    "auth-bridge:check": "wrangler deploy --dry-run --config services/auth-bridge/wrangler.jsonc",
    "gemini-relay:test": "node --test services/gemini-relay/server.test.mjs",
    "supabase:functions:check": "npx --yes deno@2.5.4 check --config supabase/functions/deno.json --lock supabase/functions/deno.lock --frozen supabase/functions/delete-account/index.ts supabase/functions/cleanup-report-photos/index.ts supabase/functions/send-cleanup-notifications/index.ts supabase/functions/create-cleanup-contribution/index.ts supabase/functions/create-cleaner-onboarding-link/index.ts supabase/functions/stripe-onboarding-redirect/index.ts supabase/functions/stripe-webhook/index.ts supabase/functions/admin-cleanup-case/index.ts supabase/functions/run-financial-maintenance/index.ts",
    "supabase:functions:test": "npx --yes deno@2.5.4 test --allow-env --config supabase/functions/deno.json --lock supabase/functions/deno.lock --frozen supabase/functions/_shared/funded-cleanup.test.ts",
    "web:dev": "npm run dev --workspace @litterbugs/web",
    "web:build": "npm run build --workspace @litterbugs/web",
    "web:start": "npm run start --workspace @litterbugs/web",
    "web:lint": "npm run lint --workspace @litterbugs/web",
    "web:test:cross-browser": "npm exec --workspace @litterbugs/web playwright test -- --config=playwright.live.config.ts",
    "web:boundaries": "node scripts/check-web-boundaries.mjs",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "check": "npm run typecheck && npm test && npm run web:lint && npm run web:build && npm run web:boundaries && npm run supabase:functions:check && npm run supabase:functions:test && npm run gemini-relay:test && npm run auth-bridge:check"
  },
  "devDependencies": {
    "patch-package": "8.0.1",
    "wrangler": "4.125.0"
  }
}
